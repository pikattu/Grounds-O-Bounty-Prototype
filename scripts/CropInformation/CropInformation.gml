function CropInformation(){
	
	global.CropCorn = 
	{
		Sprite: sPlantCorn,
		GrowTime: 100,
		Drop: [global.ItemCorn, 5]
	}
	global.CropPineapple = 
	{
		Sprite: sPlantPineapple,
		GrowTime: 100,
		Drop: [global.ItemPineapple, 2]
	}
	
	global.CropRice = 
	{
		Sprite: sPlantRice,
		GrowTime: 100,
		Drop: [global.ItemRice, 5],
	}
	
	global.CropStrawberry = 
	{
		Sprite: sStrawberryPlant,
		GrowTime: 100,
		Drop: [global.ItemStrawberry, 5]
	}
	
}